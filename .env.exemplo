# =====================================================================
# COPIE ESTE ARQUIVO PARA .env E PREENCHA. O .env NÃO VAI PARA O GIT.
# =====================================================================

# --- Ambiente --------------------------------------------------------
# homologacao = produção restrita (tpAmb 2). Use até validar tudo.
# producao    = notas com valor fiscal real (tpAmb 1).
AMBIENTE=homologacao

# --- Certificado Digital A1 -----------------------------------------
# OPÇÃO A (recomendada): aponte direto para o .pfx/.p12 da sua AC.
#   Sem conversão manual, sem chave decifrada em disco.
CERT_PFX=certificado.pfx
CERT_PFX_SENHA=sua-senha-do-pfx

# OPÇÃO B: PEMs já convertidos (veja "Convertendo o Certificado A1" no README).
#   Só são usados se CERT_PFX estiver vazio/comentado.
CERT_CRT=certificado.crt
CERT_KEY=chave.key
CERT_KEY_SENHA=

# --- Prestador (sua empresa) ----------------------------------------
PRESTADOR_CNPJ=00000000000000
PRESTADOR_IM=                       # Inscrição Municipal (CCM). Vazio se não houver.
PRESTADOR_COD_MUNICIPIO=3304557     # IBGE do Rio de Janeiro/RJ
PRESTADOR_SIMPLES_NACIONAL=3        # 1=Não optante 2=MEI 3=Simples Nacional
PRESTADOR_REGIME_ESPECIAL=0         # 0=Nenhum ... 6=ME/EPP Simples

# --- Serviço (consultoria) ------------------------------------------
SERVICO_CTRIBNAC=170101             # LC 116, subitem 17.01 — assessoria/consultoria
SERVICO_COD_MUNICIPIO=3304557       # município de prestação (IBGE)
SERVICO_TRIB_ISSQN=1                # 1=tributável 2=exportação 3=não incidência 4=imunidade
SERVICO_RET_ISSQN=1                 # 1=não retido 2=retido pelo tomador
SERVICO_IND_TOT_TRIB=0              # 0=não informa totais aprox. 1=informa 2=sem valor
ISS_ALIQUOTA=                       # Ex.: 2.00. Deixe VAZIO se optante do Simples.

# --- Arquivos e numeração -------------------------------------------
PLANILHA=faturamento.xlsx
DIR_NOTAS=notas
DIR_LOGS=logs
DPS_SERIE=1
DPS_NUMERO_INICIAL=1                # próximo nDPS livre da sua série

# --- HTTP ------------------------------------------------------------
HTTP_TIMEOUT=60
HTTP_MAX_TENTATIVAS=3

# --- E-mail (envio automático da nota ao cliente) --------------------
# A nota autorizada é enviada para a coluna Email_Cliente da planilha,
# com o DANFSe (PDF) e o XML da NFS-e em anexo.
EMAIL_ENVIAR=false                  # true para ligar o envio automático
EMAIL_SMTP_SERVIDOR=smtp.gmail.com
EMAIL_SMTP_PORTA=587
EMAIL_STARTTLS=true                 # true na porta 587; false na 465 (SSL direto)
EMAIL_SMTP_USUARIO=seu-email@suaempresa.com.br
# Gmail/Workspace: use uma SENHA DE APP (Conta Google > Segurança >
# Verificação em duas etapas > Senhas de app). A senha da conta não funciona.
EMAIL_SMTP_SENHA=sua-senha-de-app
EMAIL_REMETENTE=seu-email@suaempresa.com.br
EMAIL_REMETENTE_NOME=Consultoria Mari Torres
EMAIL_BCC=                          # cópia oculta, ex.: contador@escritorio.com.br

# Trava de segurança: em homologação o envio é bloqueado por padrão.
EMAIL_PERMITIR_HOMOLOGACAO=false
EMAIL_TESTE_DESTINO=                # se preenchido, TODO e-mail vai para cá

# Modelos. Variáveis disponíveis: {tomador} {prestador} {competencia}
# {descricao} {valor} {chave} {chave_curta}
EMAIL_ASSUNTO=NFS-e {chave_curta} - {competencia}
EMAIL_CORPO=                        # vazio = usa o modelo padrão do script

# --- Assinatura XMLDSig ---------------------------------------------
# sha1  = padrão histórico dos webservices fiscais brasileiros (default)
# sha256 = use se o MOC da NFS-e Nacional exigir na sua versão de layout
ASSINATURA_ALGORITMO=sha1

# --- Backup automático ----------------------------------------------
# Pasta para onde as notas e o controle de numeração são copiados a cada
# emissão. OneDrive, Google Drive ou unidade de rede servem — aqui é cópia
# de arquivo, não banco aberto. Vazio = sem backup.
DIR_BACKUP=
